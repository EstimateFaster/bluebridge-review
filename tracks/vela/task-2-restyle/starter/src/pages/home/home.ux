.review-title { width: 292px; height: 26px; color: #ffd400; font-size: 20px; line-height: 26px; font-weight: bold; lines: 1; }
.review-text { width: 292px; height: 23px; margin-top: 3px; color: #a0a0a0; font-size: 16px; line-height: 23px; lines: 1; }
