<template>
  <div class="page">
    <div class="topbar">
      <text class="home-title">股市大亨</text>
      <text class="top-meta">第 {{gameDay}} 日</text>
      <div class="icon-hit" onclick="openSettings">
        <image static class="action-icon" src="/common/icons/settings.png"></image>
      </div>
    </div>
    <div class="content-layer flow-content-layer">
      <scroll class="home-scroll" scroll-y="true" scroll-x="false">
        <div class="asset-card">
          <text class="asset-label">总资产 · 静态演示</text>
          <div class="asset-money-row">
            <div class="asset-value-box">
              <text class="asset-value">{{assetsText}}</text>
            </div>
            <div class="asset-profit-box">
              <text class="asset-profit {{profitClass}}">{{profitText}}</text>
            </div>
          </div>
          <div class="asset-divider"></div>
          <div class="asset-meta-row">
            <div class="asset-meta-cell">
              <text class="asset-meta-label">现金</text>
              <text class="asset-meta-value">{{cashText}}</text>
            </div>
            <div class="asset-meta-cell asset-meta-cell-right">
              <text class="asset-meta-label asset-meta-label-right">持仓市值</text>
              <text class="asset-meta-value asset-meta-value-right">{{holdingText}}</text>
            </div>
          </div>
        </div>
        <div class="tile-row">
          <div class="home-tile stock-tile tile-gap" onclick="openMarket">
            <image static class="tile-image" src="/common/cards/stock.png"></image>
          </div>
          <div class="home-tile portfolio-tile" onclick="openPortfolio">
            <image static class="tile-image" src="/common/cards/portfolio.png"></image>
          </div>
        </div>
        <div class="review-card">
          <text class="review-title">静态壳 · 演示数据</text>
          <text class="review-text">玩法逻辑已裁剪，仅保留界面展示。</text>
          <text class="review-text">行情与持仓均为固定虚构数据。</text>
        </div>
        <text class="review-foot">蓝桥工作室 · 仅供招新评测使用</text>
      </scroll>
    </div>
  </div>
</template>
<script>
import router from "@system.router"
import {
  ACCOUNT,
  formatMoney,
  formatSignedMoney,
  totalAssets,
  totalHoldingValue,
  totalHoldingProfit,
  trendClass
} from "../../data/reviewStatic.js"
export default {
  private: {
    gameDay: 1,
    assetsText: "",
    profitText: "",
    profitClass: "neutral",
    cashText: "",
    holdingText: ""
  },
  onInit() {
    const profit = totalHoldingProfit()
    this.gameDay = ACCOUNT.gameDay
    this.assetsText = formatMoney(totalAssets())
    this.holdingText = formatMoney(totalHoldingValue())
    this.cashText = formatMoney(ACCOUNT.cash)
    this.profitText = formatSignedMoney(profit)
    this.profitClass = trendClass(profit)
  },
  openMarket() {
    router.push({ uri: "/pages/market" })
  },
  openPortfolio() {
    router.push({ uri: "/pages/portfolio" })
  },
  openSettings() {
    router.push({ uri: "/pages/settings" })
  }
}
</script>
