.asset-money-row { width: 292px; height: 54px; flex-shrink: 0; flex-direction: row; align-items: center; }
.asset-value-box { width: 184px; height: 54px; justify-content: center; }
.asset-profit-box { width: 108px; height: 54px; align-items: flex-end; justify-content: center; }
.asset-value { width: 184px; height: 48px; color: #ffffff; font-size: 39px; line-height: 48px; font-weight: bold; lines: 1; text-overflow: ellipsis; }
.asset-profit { width: 108px; height: 34px; font-size: 23px; line-height: 34px; font-weight: bold; text-align: right; lines: 1; text-overflow: ellipsis; }
