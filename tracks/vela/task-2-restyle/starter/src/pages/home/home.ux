.asset-meta-label { width: 146px; height: 21px; color: #a0a0a0; font-size: 17px; line-height: 21px; lines: 1; }
.asset-meta-value { width: 146px; height: 26px; color: #ffffff; font-size: 21px; line-height: 26px; font-weight: bold; lines: 1; text-overflow: ellipsis; }
.asset-meta-label-right,.asset-meta-value-right { text-align: right; }
.tile-row { width: 100%; height: 112px; margin-top: 8px; flex-direction: row; }
